NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://icofyz_user:CHANGE_ME@localhost:5432/icofyz
# For a same-region Render internal database URL, leave DATABASE_SSL unset/false.
# For an external Render PostgreSQL URL, append ?sslmode=require to DATABASE_URL.
DATABASE_SSL=false
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD_14_CHARS_MINIMUM
# Optional. Render Blueprint sets this to /var/data/uploads.
UPLOAD_DIR=server/uploads
